# Web env contract. Copy to apps/web/.env.local (gitignored) and fill in.
#
# Only the NEXT_PUBLIC_ prefix is exposed to the browser — variables without it
# stay server-only. So ONLY public, client-safe values go here.
#
# Use the PUBLISHABLE key (sb_publishable_…), which is safe in the client and
# gated by Row Level Security. NEVER put the secret key (sb_secret_…) in this
# app — it bypasses RLS and must stay server/CLI-side only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
