# Mobile env contract. Copy to apps/mobile/.env (gitignored) and fill in.
#
# Only the EXPO_PUBLIC_ prefix is bundled into the app — variables without it
# are NOT available at runtime. So ONLY public, client-safe values go here.
#
# Use the PUBLISHABLE key (sb_publishable_…), which is safe in the client and
# gated by Row Level Security. NEVER put the secret key (sb_secret_…) in this
# app — it bypasses RLS and must stay server/CLI-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# NOTE: Google sign-in needs NO variable here. It runs through the same
# browser-redirect flow as Discord, so Supabase holds the client id + secret and
# the app only ever names the provider. There is deliberately no
# EXPO_PUBLIC_GOOGLE_* var and no iOS/Android Google client id — those belong to
# the native flow, which this app does not use. Apple is the only native
# provider, and it needs no env var either (it is configured by the
# expo-apple-authentication plugin in app.json).
