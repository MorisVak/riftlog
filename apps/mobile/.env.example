# Mobile env contract. Copy to apps/mobile/.env (gitignored) and fill in.
#
# Only the EXPO_PUBLIC_ prefix is bundled into the app — variables without it
# are NOT available at runtime. So ONLY public, client-safe values go here.
#
# Use the PUBLISHABLE key (sb_publishable_…), which is safe in the client and
# gated by Row Level Security. NEVER put the secret key (sb_secret_…) in this
# app — it bypasses RLS and must stay server/CLI-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google native sign-in. OAuth *client IDs* are public by design — they ship in
# the app binary either way — so they belong here, not in supabase/.env. The
# client SECRET is a different thing and goes only in the Supabase dashboard.
#
# Create three clients in Google Cloud → Credentials:
#   - Web     → its ID is EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID below, and its ID +
#               secret go into the Supabase Google provider.
#   - iOS     → bundle com.m-mecke.riftlog. Its ID goes below, and its REVERSED
#               form (com.googleusercontent.apps.…) is the `iosUrlScheme` in
#               app.json, which must be replaced there by hand.
#   - Android → package com.mmecke.riftlog (per app.json) + your SHA-1.
#
# The iOS and Android client IDs must ALSO be listed in the Supabase Google
# provider's "Authorized Client IDs", or signInWithIdToken rejects the token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
